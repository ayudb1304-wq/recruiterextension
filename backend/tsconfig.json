{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  // src only. Worker code must NOT see Node's globals — if `node:fs` typechecks
  // here, someone will eventually import it and the deploy will fail at runtime.
  // Tests get their own config (tsconfig.tests.json).
  "include": ["src/**/*.ts", "../shared/src/**/*.ts"]
}
