{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recruitexport-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Non-secret vars. Secrets go in via `wrangler secret put` (docs/08 §7):
  //   SUPABASE_SERVICE_KEY, JWT_SECRET, ENRICH_API_KEY, DODO_WEBHOOK_SECRET,
  //   EMAIL_API_KEY
  "vars": {
    "ENVIRONMENT": "development",
    "ENRICH_PROVIDER": "mock",
    "SITE_BASE": "http://localhost:4173",
    "EMAIL_FROM": "login@example.com",

    // Not a secret — the project ref is public in every Supabase URL. The
    // SERVICE KEY that goes with it is a wrangler secret, never a var.
    "SUPABASE_URL": "https://ydofetvwqkbsdbkbqkmn.supabase.co",

    // Dodo TEST-mode product ids, created 2026-08-16 by scripts/dodo-setup.mjs.
    // Not secrets — they appear in checkout URLs. Live-mode ids will differ, so
    // set those per-environment when you go live.
    "DODO_PRODUCT_ID_PRO_MONTHLY": "pdt_0NlVzqS2nyO0HQfk57yom",
    "DODO_PRODUCT_ID_PRO_ANNUAL": "pdt_0NlVzqTrOt7JE3kgUJNvD"
  },

  // KV for rate-limit counters, magic-link tokens, job reservations and
  // webhook idempotency (docs/05 §4, §6, §8).
  // Human task, Phase 5: `wrangler kv namespace create RE_KV` and paste the id.
  "kv_namespaces": [
    {
      "binding": "RE_KV",
      "id": "13ecb4f7345f402a8857131934a0a1dc",
      "preview_id": "56af6185b74c41f0a284e5cdf20206b0"
    }
  ]
}
