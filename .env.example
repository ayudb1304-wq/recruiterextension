# ─────────────────────────────────────────────────────────────────────────────
# RecruitExport — environment reference
#
# NOTHING in this file is a secret. Real secrets live ONLY in the Worker via
# `wrangler secret put <NAME>` (docs/08 §7). The extension bundle must contain
# zero API keys — anyone can unzip a CRX (CLAUDE.md guardrail 4).
# ─────────────────────────────────────────────────────────────────────────────

# ── extension/.env  (baked at build time by WXT; public values only) ─────────
WXT_API_BASE=http://localhost:8787
# Google Cloud OAuth client id for the Sheets export (Phase 3, human task).
# Type: "Chrome App", tied to the extension id.
WXT_GOOGLE_CLIENT_ID=
# Set to 1 in dev builds to expose the fixture-capture command (docs/03 §7).
WXT_DEV_CAPTURE=0

# ── backend/.dev.vars  (wrangler dev only; prod uses `wrangler secret put`) ──
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=
JWT_SECRET=
ENRICH_API_KEY=
ENRICH_PROVIDER=mock
DODO_WEBHOOK_SECRET=
DODO_CHECKOUT_URL_PRO_MONTHLY=
DODO_CHECKOUT_URL_PRO_ANNUAL=
DODO_PORTAL_URL=
DODO_PRODUCT_ID_PRO_MONTHLY=
DODO_PRODUCT_ID_PRO_ANNUAL=
EMAIL_API_KEY=
EMAIL_FROM=login@example.com
SITE_BASE=http://localhost:4173
ALLOWED_EXTENSION_ID=
