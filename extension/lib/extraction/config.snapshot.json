        "scrollContainer": ["#search-results-container", "ol.artdeco-list"],
        "pageIndicator": [".artdeco-pagination__page-state", "[data-test-pagination-page-state]"]
      },
      "platformWarning": [
        "form[action*='checkpoint']",
        "#captcha-internal",
        "[data-test-challenge]",
        "iframe[src*='captcha']",
        "iframe[title*='reCAPTCHA']"
      ],
      "fields": [
        {
          "field": "fullName",
          "strategies": [
            { "tier": 1, "type": "css", "selector": "[data-anonymize='person-name']" },
            { "tier": 1, "type": "relative", "from": "cardRoot", "path": "a[href*='/sales/lead/'] span[dir='ltr']" },
            { "tier": 3, "type": "css", "selector": ".artdeco-entity-lockup__title a" }
          ],
          "postprocess": ["stripZeroWidth", "cleanName", "collapseWhitespace", "nullIfEmpty"]
        },
        {
          "field": "profileUrl",
          "strategies": [
            { "tier": 1, "type": "attr", "selector": "a[href*='/sales/lead/']", "attribute": "href" },
            { "tier": 1, "type": "attr", "selector": "a[href*='/in/']", "attribute": "href" },
            { "tier": 3, "type": "attr", "selector": ".artdeco-entity-lockup__title a", "attribute": "href" }
          ],
          "postprocess": ["canonicalizeUrl"]
        },
        {
          "field": "headline",
          "strategies": [
            { "tier": 1, "type": "css", "selector": "[data-anonymize='headline']" },
            { "tier": 1, "type": "css", "selector": "[data-anonymize='title']" },
            { "tier": 3, "type": "css", "selector": ".artdeco-entity-lockup__subtitle" }
          ],
          "postprocess": ["stripZeroWidth", "collapseWhitespace", "nullIfEmpty"]
        },
        {
          "field": "currentTitle",
          "strategies": [
            { "tier": 1, "type": "css", "selector": "[data-anonymize='job-title']" },
            { "tier": 2, "type": "textRegex", "pattern": "Current:\\s*([^·|\\n]+?)\\s+(?:at|@)\\s", "group": 1 },
            { "tier": 3, "type": "css", "selector": ".artdeco-entity-lockup__subtitle" }
          ],
          "postprocess": ["stripLeadingLabel", "collapseWhitespace", "nullIfEmpty"],
          "expected": false
        },
        {
          "field": "currentCompany",
          "strategies": [
            { "tier": 1, "type": "css", "selector": "[data-anonymize='company-name']" },
            { "tier": 1, "type": "relative", "from": "cardRoot", "path": "a[href*='/sales/company/']" },
            { "tier": 2, "type": "textRegex", "pattern": "Current:\\s*.*?\\s+(?:at|@)\\s+([^·|\\n]+)", "group": 1 },
            { "tier": 3, "type": "css", "selector": ".artdeco-entity-lockup__subtitle a" }
          ],
          "postprocess": ["cleanCompany", "nullIfEmpty"]
        },
        {
          "field": "location",
          "strategies": [
            { "tier": 1, "type": "css", "selector": "[data-anonymize='location']" },
            { "tier": 3, "type": "css", "selector": ".artdeco-entity-lockup__caption" }
          ],
          "postprocess": ["stripLeadingLabel", "collapseWhitespace", "nullIfEmpty"]
        },
        {
          "field": "tenureAtCompany",
          "strategies": [
            { "tier": 2, "type": "textRegex", "pattern": "(\\d+\\s*(?:yrs?|years?)(?:\\s*\\d+\\s*(?:mos?|months?))?)\\s*(?:in\\s+(?:role|company))?", "group": 1 },
            { "tier": 2, "type": "textRegex", "pattern": "(\\d+\\s*(?:mos?|months?))\\s*(?:in\\s+(?:role|company))", "group": 1 },
            { "tier": 2, "type": "textRegex", "pattern": "(less than a year)", "group": 1 }
          ],
          "postprocess": ["normalizeTenure"],
          "expected": false
        },
        {
          "field": "mutualConnections",
          "strategies": [
            { "tier": 2, "type": "textRegex", "pattern": "([\\d,]+)\\s+(?:shared|mutual)\\s+connection", "group": 1 },
            { "tier": 2, "type": "textRegex", "pattern": "(\\d+)\\s+shared", "group": 1 }
          ],
          "postprocess": ["digitsOnly"],
          "expected": false
        },
        {
          "field": "openToWork",
          "strategies": [
            { "tier": 1, "type": "css", "selector": "[data-anonymize='open-to-work']", "extract": "exists" },
            { "tier": 2, "type": "textRegex", "pattern": "(open to work)", "group": 1 },
            { "tier": 3, "type": "css", "selector": ".artdeco-entity-lockup__badge", "extract": "exists" }
          ],
          "postprocess": [],
          "expected": false
        }
      ]
    },

