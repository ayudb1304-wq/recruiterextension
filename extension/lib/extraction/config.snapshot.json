        { "id": "resultsList", "selector": "#search-results-container, [data-view-name='search-results-container']" },
        { "id": "resultCard", "selector": "li.artdeco-list__item, [data-x-search-result]" },
        { "id": "paginationBar", "selector": "[data-test-pagination], .artdeco-pagination" }
      ],
      "resultsContainer": [
        "#search-results-container",
        "[data-view-name='search-results-container']",
        "ol.artdeco-list",
        "main"
      ],
      "cardSelectors": [
        "[data-x-search-result]",
        "li.artdeco-list__item",
        "ol.artdeco-list > li"
      ],
      "pagination": {
        "nextButton": [
          "button[aria-label='Next']",
          "button[aria-label='Next page']",
          ".artdeco-pagination__button--next"
