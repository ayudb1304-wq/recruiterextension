{
  "_readme": "UNVERIFIED SEED SNAPSHOT — see ./README.md. Selectors below are the spec's own examples (docs/03 §3) plus conservative structural anchors. They MUST be validated against real captured fixtures (docs/03 §7) before launch. Keys starting with _ are stripped by the zod schema.",
  "configVersion": "0.0.0-seed",
  "profiles": {
    "salesnav_people_search": {
      "profileId": "salesnav_people_search",
      "urlPatterns": ["^https://www\\.linkedin\\.com/sales/search/people"],
